{
  // Settings come from the environment and ./.env (see .env.example).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "noDebug": true,
      "program": "${workspaceFolder}/cmd/classifier",
      "cwd": "${workspaceFolder}",
      // logs go to stderr, which the Debug Console paints red
      "console": "integratedTerminal"
    },
    {
      "name": "Debug",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/classifier",
      "cwd": "${workspaceFolder}",
      // logs go to stderr, which the Debug Console paints red
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Tests (current package)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    }
  ]
}
