{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Debug FastAPI",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/src/app/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "justMyCode": false
        },
        {
            "name": "🔧 Debug Main (CLI)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/src/app/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "justMyCode": false
        }
    ],
    "compounds": [
        {
            "name": "🚀 Debug All",
            "configurations": [
                "🚀 Debug FastAPI",
            ],
            "stopAll": true,
            "presentation": {
                "hidden": false,
                "group": "main",
                "order": 0
            }
        }
    ]
}
